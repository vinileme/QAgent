# =============================================================================
# JARVINIS — Configuração completa (.env)
# Copie: cp .env.example .env
# Valide: npm run check:env
# =============================================================================

# -----------------------------------------------------------------------------
# Ollama (obrigatório)
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434

# Frente 1 — Chat local (PC, Open WebUI, celular na rede)
OLLAMA_MODEL=jarvinis

# Frente 2 — Agente QA (roteador + especialista + historiador)
OLLAMA_ROUTER_MODEL=deepseek-r1:14b
OLLAMA_QA_MODEL=qwen2.5-coder:14b
OLLAMA_HISTORY_MODEL=jarvinis

# -----------------------------------------------------------------------------
# Obsidian QA Mind (RAG — notas de engenharia)
# -----------------------------------------------------------------------------
OBSIDIAN_VAULT_PATH=/Users/SEU_USUARIO/Documents/Repo/Personal/QA Mind

# -----------------------------------------------------------------------------
# Caminho deste repositório (pipes Open WebUI — use caminho absoluto)
# -----------------------------------------------------------------------------
JARVINIS_ROOT=/Users/SEU_USUARIO/Documents/Repo/Personal/antigravity-qa-agent

# Sessões chat/QA (padrão: .jarvinis/sessions dentro do projeto)
JARVINIS_SESSION_DIR=/Users/SEU_USUARIO/Documents/Repo/Personal/antigravity-qa-agent/.jarvinis/sessions

# -----------------------------------------------------------------------------
# qa_sandbox — bootstrap automático de testes
# -----------------------------------------------------------------------------
# Cria package.json + Jest/Vitest/Playwright ao gravar testes
QA_SANDBOX_AUTO_BOOTSTRAP=true
# Roda npm install na sandbox antes do primeiro EXECUTE_TEST
QA_SANDBOX_AUTO_INSTALL=true
# Timeout do npm install (ms)
QA_SANDBOX_INSTALL_TIMEOUT=120000
# Runner padrão se o projeto alvo não tiver package.json
QA_SANDBOX_DEFAULT_RUNNER=jest
# Instalar browser Chromium para Playwright (demorado, ~300MB)
QA_SANDBOX_PLAYWRIGHT_INSTALL=false

# -----------------------------------------------------------------------------
# Alexa (Frente voz — opcional)
# -----------------------------------------------------------------------------
PORT=3001
